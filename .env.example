# Copy to `.env` and fill in. See docs/SETUP_META.md.
# (.env is gitignored — never commit real tokens.)

# Meta Graph API (Instagram Reels + Facebook)
META_ACCESS_TOKEN=
IG_USER_ID=
FB_PAGE_ID=
# Public base URL where the `output/` folder is served (Instagram needs a public
# video URL; e.g. https://your-host/graphbot or an ngrok tunnel).
PUBLIC_BASE_URL=
META_GRAPH_VERSION=v21.0

# Analytics warehouse (Postgres). Create the DB first, then:
#   python -m graph_bot.analytics init
#   python -m graph_bot.analytics import
DATABASE_URL=postgresql://postgres:YOURPASSWORD@localhost:5432/youtube_db
